# ChitraVision ML Service — environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# HuggingFace model to load
MODEL_ID=dima806/deepfake_vs_real_image_detection

# Read token for downloading the model (only needed for gated/private models)
HF_TOKEN=

# 1 to use deterministic mock inference (no model download — for dev/tests)
MOCK_INFERENCE=0

# Upload limits
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=50
MAX_VIDEO_DURATION_S=120

# Camera frame sampling (analyze every Nth frame of a video)
FRAME_SAMPLE_INTERVAL=30

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO