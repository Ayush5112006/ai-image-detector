# ChitraVision ML Service — environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# ── Model backend ─────────────────────────────────────────────────────────────
# Set USE_LOCAL_MODEL=1 (default) to use the local EfficientNet-B0 checkpoint
# located at ml_service/models/deepfake_efficientnet_b0.pt.
# Set to 0 to download and use the HuggingFace ViT model instead.
USE_LOCAL_MODEL=1

# Optional: override the path to the local model file.
# LOCAL_MODEL_PATH=/absolute/path/to/deepfake_efficientnet_b0.pt

# HuggingFace model (only used when USE_LOCAL_MODEL=0)
MODEL_ID=manishpandey68/detection-of-ai-generated-images-through-ViT

# HuggingFace token (only needed for gated/private HF models)
HF_TOKEN=

# 1 to use deterministic mock inference (no model loading — for dev/tests)
MOCK_INFERENCE=0

# Upload limits
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=50
MAX_VIDEO_DURATION_S=120

# Camera frame sampling (analyze every Nth frame of a video)
FRAME_SAMPLE_INTERVAL=30

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO