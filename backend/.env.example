# ChitraVision Backend — environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# MongoDB (Atlas or local)
# mongodb://localhost:27017/chitravision
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/dbname?retryWrites=true&w=majority

# JWT signing secret — use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-me-with-a-long-random-string

# FastAPI / ML service
FASTAPI_URL=http://localhost:8000
# Timeout (ms) for ML inference calls
ML_TIMEOUT_MS=120000
# Set to 1 to bypass the ML service in local/dev testing (deterministic results)
MOCK_ML=0

# Upload limits (MB)
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=50

# Email (nodemailer SMTP — Gmail app password recommended)
SENDER_EMAIL=you@gmail.com
SENDER_APP_PASSWORD=your-16-char-gmail-app-password

# Google Sign-In — OAuth client ID the app's Google Sign-In uses (must match
# the ID token's `aud`). Optional: until set, POST /api/auth/google returns
# 500 "Google Sign-In is not configured on the server".
# GOOGLE_CLIENT_ID=1234-your-client.apps.googleusercontent.com
# Integration-test ONLY — skips Google token verification. Never enable in prod.
# MOCK_GOOGLE_AUTH=0