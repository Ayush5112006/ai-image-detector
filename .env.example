# ChitraVision AI — Flutter app environment template.
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# The app reads this at startup via flutter_dotenv (pubspec: assets/.env).
# It can also be overridden per-build:
#   flutter run --dart-define=API_BASE_URL=https://your-backend.com

# Backend REST API base URL (used automatically by the app)
API_BASE_URL=http://localhost:4000

# Optional: sender email config (legacy client-side email paths)
SENDER_EMAIL=you@gmail.com
SENDER_APP_PASSWORD=

# Legacy EmailJS config (unused when the backend sends emails)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=